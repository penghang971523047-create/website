---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('writing', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="文章 · Helix">
  <main class="section"><div class="wrap narrow">
    <p class="eyebrow">文章</p>
    <h1 class="h2">写下来的思考</h1>
    <ul class="list">
      {posts.map((p) => (
        <li>
          <a href={`${base}writing/${p.id}/`}><h2>{p.data.title}</h2></a>
          <p class="meta">{fmt(p.data.date)}</p>
          <p class="sum">{p.data.summary}</p>
        </li>
      ))}
    </ul>
  </div></main>
</Base>
<style>
  .narrow { max-width: 760px; }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { padding: 24px 0; border-top: 1px solid var(--line); }
  .list h2 { font-family: var(--font-serif); font-size: 22px; color: var(--text); }
  .meta { color: var(--muted); font-size: 14px; margin: 6px 0; }
  .sum { margin: 0; color: var(--muted); }
</style>
