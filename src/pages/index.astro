---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Wash from '../components/Wash.astro';
import { profile, projects, experience, skills } from '../data/site';
const base = import.meta.env.BASE_URL;
const cvHref = profile.cvPdf ? `${base}${profile.cvPdf}` : '';
---
<Base>
  <main id="top">
    <section class="hero">
      <div class="wrap hero-in">
        <div class="hero-text">
        <p class="eyebrow">{profile.title}</p>
        <h1>{profile.tagline}</h1>
        <p class="lead">{profile.intro}</p>
        <div class="cta">
          <a class="btn primary" href="#contact">联系我</a>
          {cvHref
            ? <a class="btn" href={cvHref} download>下载简历</a>
            : <a class="btn" href="#experience">查看经历</a>}
        </div>
        </div>
        <Wash />
      </div>
    </section>

    <section id="projects" class="section ruled">
      <div class="wrap">
        <p class="eyebrow">精选项目</p>
        <h2 class="h2">做出来的东西</h2>
        <div class="grid">
          {projects.map((p, i) => (
            <article class={`card ${i === 0 ? 'wide' : ''}`}>
              <div class="art-box"><div class="frame"><span class="dots"><i></i><i></i><i></i></span><Art kind={p.art} /></div></div>
              <div class="card-body">
                <h3>{p.name}</h3>
                <p class="one">{p.oneLiner}</p>
                <dl>
                  <dt>问题</dt><dd>{p.problem}</dd>
                  <dt>做法</dt><dd>{p.approach}</dd>
                  <dt>结果</dt><dd class="result">{p.result}</dd>
                </dl>
                <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
                {p.link && <a class="more" href={`${base}${p.link.path}`}>{p.link.label} →</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="section">
      <div class="wrap narrow">
        <p class="eyebrow">经历</p>
        <h2 class="h2">一路走来</h2>
        <ol class="timeline">
          {experience.map((e) => (
            <li>
              <div class="period">{e.period}</div>
              <div>
                <h3>{e.role}</h3>
                <p class="org">{e.org}</p>
                <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="skills" class="section alt">
      <div class="wrap">
        <p class="eyebrow">能力</p>
        <h2 class="h2">我能带来什么</h2>
        <div class="skills">
          {skills.map((s) => (
            <div class="skill">
              <h3>{s.group}</h3>
              <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="wrap narrow center">
        <p class="eyebrow">联系</p>
        <h2 class="h2">聊聊合作或机会</h2>
        <p class="lead">欢迎邮件联系，通常 24 小时内回复。</p>
        <div class="cta">
          <a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>
          {profile.phones.map((ph) => <a class="btn" href={`tel:${ph.replace(/\s/g, '')}`}>{ph}</a>)}
          {profile.wechat && <span class="btn">微信：{profile.wechat}</span>}
          {cvHref && <a class="btn" href={cvHref} download>下载简历</a>}
        </div>
        {profile.links.length > 0 && (
          <p class="links">{profile.links.map((l) => <a href={l.url}>{l.label}</a>)}</p>
        )}
      </div>
    </section>
  </main>

</Base>

<style>

  .hero { padding: 96px 0 88px; }
  .hero-in { display: grid; grid-template-columns: 1.25fr 1fr; gap: 48px; align-items: center; }
  .hero-text { min-width: 0; }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(34px, 5.4vw, 58px);
    line-height: 1.16; font-weight: 600; letter-spacing: -0.015em;
    margin: 14px 0 0; text-wrap: balance;
  }
  .lead { color: var(--muted); font-size: clamp(17px, 2vw, 20px); max-width: 34em; margin: 22px 0 0; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 34px; }
  .btn {
    display: inline-flex; align-items: center; height: 44px; padding: 0 22px;
    border-radius: 980px; border: 1px solid var(--line); color: var(--text); font-size: 16px;
  }
  .btn:hover { text-decoration: none; border-color: var(--text); }
  .btn.primary { background: var(--ink); border-color: var(--ink); color: var(--ink-fg); }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .card { background: var(--card); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .card.wide { grid-column: 1 / -1; flex-direction: row; }
  .card.wide .art-box { flex: 1 1 50%; }
  .card.wide .card-body { flex: 1 1 50%; align-self: center; }
  .art-box { background: var(--bg-alt); padding: 28px 28px 0; }
  .card.wide .art-box { padding: 32px; display: flex; align-items: center; }
  .frame { background: var(--card); border: 1px solid var(--line); border-bottom: 0; border-radius: 12px 12px 0 0; padding: 10px 16px 6px; width: 100%; }
  .card.wide .frame { border-bottom: 1px solid var(--line); border-radius: 12px; }
  .dots { display: flex; gap: 6px; margin-bottom: 4px; }
  .dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--line); display: block; }
  .card-body { padding: 26px 30px 30px; }
  .card h3 { font-size: 24px; }
  .one { margin: 8px 0 18px; font-size: 17px; }
  dl { margin: 0; display: grid; grid-template-columns: 3em 1fr; gap: 6px 10px; font-size: 15px; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .result { font-weight: 600; color: var(--accent); }
  .tags { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .more { display: inline-block; margin-top: 16px; font-weight: 600; color: var(--accent); }
  .tags li { font-size: 13px; color: var(--muted); border: 1px solid var(--line); border-radius: 980px; padding: 2px 12px; }

  .narrow { max-width: 760px; }
  .timeline { list-style: none; padding: 0; margin: 0; }
  .timeline > li { display: grid; grid-template-columns: 9em 1fr; gap: 20px; padding: 26px 0; border-top: 1px solid var(--line); }
  .timeline > li:last-child { border-bottom: 1px solid var(--line); }
  .period { color: var(--muted); font-size: 15px; padding-top: 3px; }
  .timeline h3 { font-size: 20px; }
  .org { color: var(--muted); margin: 2px 0 8px; }
  .timeline ul { margin: 0; padding-left: 1.1em; }

  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .skill { background: var(--card); border-radius: var(--radius); padding: 28px; }
  .skill h3 { font-size: 20px; margin-bottom: 12px; }
  .skill ul { margin: 0; padding-left: 1.1em; color: var(--muted); }
  .skill li { margin: 4px 0; }

  .ruled { border-top: 1px solid var(--line); }
  .center { text-align: center; }
  .center .cta { justify-content: center; }
  .center .lead { margin-top: 0; }
  .links { display: flex; gap: 18px; justify-content: center; margin-top: 22px; }

  @media (max-width: 760px) {
    .grid, .skills { grid-template-columns: 1fr; }
    .card.wide { flex-direction: column; }
    .timeline > li { grid-template-columns: 1fr; gap: 6px; }
    .hero { padding: 56px 0 64px; }
    .hero-in { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
